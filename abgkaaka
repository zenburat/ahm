-- ============ TOGGLE BUILDER ============
local toggleRenderers = {}

local function buildToggle(feature, order)
    local state = Settings:Get(feature.id)

    local row = create("TextButton", {
        Text = "", AutoButtonColor = false, LayoutOrder = order,
        Size = UDim2.new(1, -6, 0, 54), BackgroundColor3 = THEME.Row,
    })
    corner(16).Parent = row
    stroke(THEME.Stroke, 1).Parent = row

    create("TextLabel", {
        Text = feature.name, Font = Enum.Font.GothamMedium, TextSize = 16, TextColor3 = THEME.Text,
        BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 7), Size = UDim2.new(0.55, 0, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row
    create("TextLabel", {
        Text = feature.desc, Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = THEME.SubText,
        BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 28), Size = UDim2.new(0.55, 0, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Left,
    }).Parent = row

    local statusLbl = create("TextLabel", {
        Text = state and "ON" or "OFF", Font = Enum.Font.Gotham, TextSize = 13,
        TextColor3 = state and THEME.Text or THEME.SubText,
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -76, 0.5, 0), Size = UDim2.fromOffset(40, 20),
        TextXAlignment = Enum.TextXAlignment.Right,
    })
    statusLbl.Parent = row

    local track = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0),
        Size = UDim2.fromOffset(52, 28),
        BackgroundColor3 = state and THEME.On or THEME.Off,
    })
    corner(14).Parent = track

    local knob = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.fromOffset(27, 14) or UDim2.fromOffset(3, 14),
        Size = UDim2.fromOffset(22, 22), BackgroundColor3 = THEME.Knob,
    })
    corner(11).Parent = knob
    stroke(THEME.Stroke, 1).Parent = knob
    knob.Parent  = track
    track.Parent = row

    row.MouseButton1Click:Connect(function()
        state = not state
        statusLbl.Text = state and "ON" or "OFF"
        tween(statusLbl, 0.15, { TextColor3 = state and THEME.Text or THEME.SubText })
        tween(track, 0.2, { BackgroundColor3 = state and THEME.On or THEME.Off })
        tween(knob, 0.2, { Position = state and UDim2.fromOffset(27,14) or UDim2.fromOffset(3,14) }, Enum.EasingStyle.Back)
        Settings:Set(feature.id, state)
    end)
    row.Parent = featureList
end

