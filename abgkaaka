-- ============ FEATURE LOGIC ============
local camera = Workspace.CurrentCamera

local HAS_DRAWING = false
pcall(function()
    if typeof(Drawing) == "table" and typeof(Drawing.new) == "function" then
        HAS_DRAWING = true
    end
end)
warn("[Valkadia] Drawing available: " .. tostring(HAS_DRAWING))

local function newDrawing(class)
    if not HAS_DRAWING then return nil end
    local ok, obj = pcall(Drawing.new, class)
    if ok then return obj end
    return nil
end

local wallRayParams = RaycastParams.new()
wallRayParams.FilterType = Enum.RaycastFilterType.Exclude
local function updateRayParams()
    local char = player.Character
    if char then wallRayParams.FilterDescendantsInstances = { char } end
end
updateRayParams()
player.CharacterAdded:Connect(updateRayParams)

local function isVisible(origin, targetPos)
    if not Settings:Get("WallCheck") then return true end
    local result = Workspace:Raycast(origin, targetPos - origin, wallRayParams)
    if not result then return true end
    local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
    if hitModel then
        local hitPlayer = Players:GetPlayerFromCharacter(hitModel)
        if hitPlayer and hitPlayer ~= player then return true end
    end
    return false
end

local function getClosestTarget(ignoreFOV)
    local closest, closestDist = nil, math.huge
    local vp = camera.ViewportSize
    local screenCenter = Vector2.new(vp.X / 2, vp.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if Settings:Get("TeamCheck") and p.Team ~= nil and p.Team == player.Team then continue end
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local bone = char and char:FindFirstChild(aimTargetBone)
        if not char or not hum or not bone then continue end
        if hum.Health <= 0 then continue end
        if Settings:Get("WallCheck") and not isVisible(camera.CFrame.Position, bone.Position) then continue end
        local screenPos, onScreen = camera:WorldToViewportPoint(bone.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if (ignoreFOV or dist <= fovRadius) and dist < closestDist then
            closestDist = dist
            closest = p
        end
    end
    return closest
end

